  "text": {
    "title": "Granary Raid",
    "body": "Raider raiders have seized the frontier grain storehouses, threatening the garrison with starvation. Storm the depot, neutralize the guards, and reclaim the grain reserves intact.",
    "obj.0": "Clear the lower valley sentries",
    "obj.1": "Defeat the three storehouse guard packs in the depot",
    "msg.1": "Uphill ground favors their archers—draw the pickets down to the terrace before charging.",
    "msg.1.who": "Captain Isolde",
    "msg.2": "Lower pickets are down. Now take the granary terrace!",
    "msg.2.who": "Vanguard Toma",
    "msg.3": "The depot is ours! Enough winter stores and silver to keep the company fed.",
    "msg.3.who": "Captain Isolde",
    "win": "The mountain storehouse depot falls into company hands.",
    "fail.1": "Your hero has fallen below the granary walls."
