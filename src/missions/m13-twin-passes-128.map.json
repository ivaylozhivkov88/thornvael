  "text": {
    "title": "Twin Passes",
    "body": "Two razor-sharp canyon passes bottleneck the road into the salt desert. Secure both defiles and destroy the basalt barricades before the desert raiders reinforce the heights.",
    "obj.0": "Break the guards holding both mountain passes",
    "obj.1": "Clear the summit command post",
    "msg.1": "Pick one pass or split the line, but clear both gates so no raiders drop behind us.",
    "msg.1.who": "Captain Isolde",
    "msg.2": "The west pass is open.",
    "msg.2.who": "Sergeant Hal",
    "msg.3": "The east pass is clear.",
    "msg.3.who": "Outrider Corin",
    "msg.4": "Both passes are ours! The surviving northern deserter from Ravenwatch Keep lowers a knotted climbing rope down the central rock chimney so our vanguard can flank the summit!",
    "msg.4.who": "Scout Wren",
    "msg.5": "The summit post falls silent. The highland trails lie open ahead.",
    "msg.5.who": "Captain Isolde",
    "win": "Both mountain passes are broken and the summit command is cleared.",
    "fail.1": "Your hero has fallen in the Twin Passes."
  },
