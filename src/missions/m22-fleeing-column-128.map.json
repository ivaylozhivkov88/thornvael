  "text": {
    "title": "Fleeing Column",
    "body": "A fleeing column of imperial deserters carries sensitive tactical ciphers across the border. Intercept the deserters before they reach sanctuary in the badlands.",
    "obj.0": "Intercept and slay Commander Vorn before he reaches the gate",
    "obj.1": "Break through the rearguard column",
    "msg.1": "Strike fast—if Vorn spots our vanguard, he will sprint for the north-east gate.",
    "msg.1.who": "Outrider Corin",
    "msg.2": "Vorn is running for the gate! Use haste or ranged fire to bring him down!",
    "msg.2.who": "Outrider Corin",
    "msg.3": "Commander Vorn is down, and his sealed dispatches are in our hands.",
    "msg.3.who": "Captain Isolde",
    "win": "Commander Vorn is intercepted and his dispatches name the Ironheart Bastion.",
    "fail.1": "Your hero has fallen in Spearwind Gorge.",
    "fail.2": "Commander Vorn reached the mountain gate and escaped with the dispatches."
  },
