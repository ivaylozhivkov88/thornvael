  "triggers": [],
  "text": {
    "title": "Thornwick Market",
    "body": "Thornwick is a fortified frontier market settlement flanked by high timber palisades. Enlist mercenary blades at the tavern, accept contracts from the garrison board, purchase tempered steel at the armory, and master runic incantations at the academy.",
    "obj.0": "Clear the wilds around Thornwick",
    "msg.1": "Step within the palisades, Commander. The mud of the outer roads clings heavy to your boots. Before you lies Thornwick: the tavern on the left for mercenary blades and whispers, the armory shop in the center for tempered steel, and the academy on the right for runic incantations. Take these silver crowns from the garrison ledger to equip your cohort.",
    "msg.1.who": "Reeve Marlow",
    "win": "The roads around Thornwick are safe again.",
    "fail.1": "Your hero has fallen.",
    "npc.reeve": "Raiders choke every mountain pass, and half the garrison is either shivering with marsh fever or drinking away their back pay. Take the tavern contracts on the board, Commander—Thornwick still pays in silver, even if the coins are tarnished by blood.",
    "npc.miller": "Gnolls broke into the mill at midnight, dragging two sacks of coarse flour into the marsh. If you march eastward toward the border ford, keep your shield tilted high—their barbed horn-bows punch straight through boiled leather.",
    "npc.gate_n1": "North Gate Sentinel: Keep your visor down against the ashfall.",
    "npc.gate_n2": "North Gate Halberdier: Cinder-drakes circle the outer spire at dusk.",
    "npc.gate_e1": "East Gate Watchman: The Sunken Ford bridge holds, barely.",
    "npc.gate_e2": "East Gate Lookout: Smoke rises from the alder reeds at dusk.",
    "npc.tanner": "Market Tanner: Boiled hides keep peat-leeches off your shins.",
    "npc.cooper": "Cooper Apprentice: Casks for salt pork and lantern oil, stacked fresh.",
    "npc.scribe": "Academy Scribe: High Arcanist Vaelen inspects every vitrified shard.",
    "npc.bellows": "Smithy Bellows-Boy: Master Kaelen keeps the coals white-hot till midnight.",
    "npc.carter": "Granary Carter: Axle grease costs less than a broken wain in the mud.",
    "npc.grave": "Orlen the Grave-Tender: Keep the tallow lit by the parish stones.",
    "npc.hound": "Stable Hound: *Low bark, ears perked toward the east palisade.*",
    "npc.fisher": "Dockside Fisher: Weir-pikes bite near the old pilings after rain.",
    "npc.vance": "Marshal Vance: Every rampart above the caldera holds on iron and grit.",
    "npc.veyra": "Harbor Marshal Veyra: The evacuation fleet sailed west; now we finish the march.",
    "npc.elda": "Weaponsmith Elda: Obsidian-quenched steel bites straight through cinder-plate.",
    "npc.orla": "Archivist Orla: The crater records show three seals beneath the threshold.",
    "npc.gate_s1": "South Gate Bombardier: Powder casks stay sealed till the breach signal.",
    "npc.gate_s2": "South Gate Lookout: Red vents glow along the caldera rim.",
    "npc.mess": "Ash-Cup Mess Steward: Filtered broth and iron rations, hot off the brazier.",
    "npc.powder": "Siege Powder-Sergeant: Keep open flame ten paces from the magazine.",
    "npc.bastion": "Granite Bastion Quartermaster: Fresh halberd hafts and spare bucklers ready.",
    "npc.cistern": "Caldera Cistern-Tender: Boiled slate-water, clean of sulfur grit."
  },
